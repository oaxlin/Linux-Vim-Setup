#!/usr/bin/perl
use strict;
use warnings;

our $VERSION = '1';

## no critic (Modules::ProhibitMultiplePackages)
package Git::Hooks::DeletedFile;

sub will_check {
    my ( $self, $filename ) = @_;
    return 1 if !-e $filename;
    return 0;
}

sub check {
    my ( $self, @paths ) = @_;
    my $errors = 0;
    for my $file (@paths) {
        $errors++ if -e $file;
    }
    return !$errors;
}

package Git::Hooks::IgnoreFile;

{
    my $forced_files;

    sub should_force {
        my ( $self, $package, $file ) = @_;
        if ( !defined $forced_files ) {
            $forced_files = {};
            my $repo_root = `git rev-parse --show-toplevel`;
            chomp $repo_root;
            die "Could not find git_root" unless $repo_root;
            if ( -e "$repo_root/.git-hooks-ignorefile" ) {
                ## no critic (InputOutput::RequireBriefOpen)
                open my $fh, '<', "$repo_root/.git-hooks-ignorefile"
                  or die "cannot open < $repo_root/.git-hooks-ignorefile: $!";
                while ( my $line = <$fh> ) {
                    chomp $line;
                    if ( $line =~ s/^([^=]+)=//x ) {
                        my $p = $1;
                        if ($p) {
                            push @{ $forced_files->{$_} }, $line
                              for ( $p, "./$p" );
                        }
                    }
                }
                close $fh or die "close failed: $!";
            }
        }
        return $forced_files->{$file} if exists $forced_files->{$file};
        return 0;
    }

    sub will_check {
        my ( $self, $filepath ) = @_;
        return __PACKAGE__->should_force( __PACKAGE__, $filepath );
    }

    sub check { return 1; }
}

package Git::Hooks::Compile::ShellCommon;

use File::Basename qw(fileparse);

sub read_first_line {
    my ($filepath) = @_;
    my $head = q{};
    if ( open my $fh, '-|', '/usr/bin/head', '-n', 1, '--', $filepath ) {
        $head = <$fh> // q{};
        close $fh or die "close failed: $!";
    }
    return $head;
}

sub will_check {
    my ( $self, $shell, $filepath ) = @_;
    die 'Shell name that supports -n required (sh / bash)' if !$shell;
    return 0 if !-e $filepath || -d $filepath;
    my $head         = read_first_line($filepath);
    my @file_infos   = fileparse( $filepath, qr/[.][^.]*/x );
    my $shell_quoted = quotemeta $shell;
    return $head =~ /^[#][!].*[\/ ]$shell_quoted$/x ? 1 : 0;
}

sub check {
    my ( $self, $shell, @paths ) = @_;
    die 'Shell name that supports -n required (sh / bash)' if !$shell;
    my $errors = 0;
    for my $file (@paths) {
        my $out = qx{$shell -n -- $file 2>&1};
        if ($?) {
            print($out);
            $errors++;
        }
    }
    return !$errors;
}

package Git::Hooks::Compile::Bash;

sub will_check {
    my ( $self, @args ) = @_;
    return Git::Hooks::Compile::ShellCommon->will_check( 'bash', @args );
}

sub check {
    my ( $self, @args ) = @_;
    return Git::Hooks::Compile::ShellCommon->check( 'bash', @args );
}

package Git::Hooks::Compile::Sh;

sub will_check {
    my ( $self, @args ) = @_;
    return Git::Hooks::Compile::ShellCommon->will_check( 'sh', @args );
}

sub check {
    my ( $self, @args ) = @_;
    return Git::Hooks::Compile::ShellCommon->check( 'sh', @args );
}

package Git::Hooks::Compile::YAML;

use File::Basename qw(fileparse basename);

sub will_check {
    my ( $self, $filepath ) = @_;
    return 0 if !-e $filepath || -d $filepath;
    return 1 if basename($filepath) eq '.kds-noroll';
    my @file_infos = fileparse( $filepath, qr/[.][^.]*/x );
    return $file_infos[2] =~ /^[.](?:yml|conf)$/x ? 1 : 0;
}

sub _check_kds_noroll {
    my ($file) = @_;
    ## no critic (InputOutput::RequireBriefOpen)
    open my $fh, '<', $file or return "cannot open $file: $!";
    my $lineno = 0;
    while ( my $line = <$fh> ) {
        $lineno++;
        chomp $line;
        next if $line =~ /^\s*$/x;
        next if $line =~ /^\s*#/x;
        my ($path) = split / /x, $line, 2;
        if ( !$path || $path =~ /\s/x ) {
            return "line $lineno: expected path (optional tags), got: $line";
        }
    }
    close $fh or die "close failed: $!";
    return;
}

sub check {
    my ( $self, @paths ) = @_;
    my $errors = 0;
    require YAML;
    for my $file (@paths) {
        if ( basename($file) eq '.kds-noroll' ) {
            my $e = _check_kds_noroll($file);
            if ($e) {
                print( $file, "\n   ", $e );
                $errors++;
            }
            next;
        }
        my $ok = eval { YAML::LoadFile($file); 1 };
        my $e  = $@;
        if ( !$ok ) {
            $e =~ s/[\n\r\s]*at .*?YAML[.]pm line \d+\s*/\n/x;
            print( $file, "\n   ", $e );
            $errors++;
        }
    }
    return !$errors;
}

package Git::Hooks::Compile::Perl;

use File::Basename qw(fileparse);

sub will_check {
    my ( $self, $filepath ) = @_;
    return 0 if !-e $filepath || -d $filepath;
    my $head = Git::Hooks::Compile::ShellCommon::read_first_line($filepath);
    my @file_infos = fileparse( $filepath, qr/[.][^.]*/x );
    return 1
      if $file_infos[2] =~ /^[.](?:pl|cgi|pm)$/x
      || $head =~ /^(?:package [^;]+;|[#][!].*[\/ ]*perl\b.*)$/x;
    return 0;
}

sub check {
    my ( $self, @paths ) = @_;
    my $errors = 0;
    for my $file (@paths) {
        my $out = qx{perl -c -w -- $file 2>&1};
        if ($?) {
            print($out);
            $errors++;
        }
    }
    return !$errors;
}

package Git::Hooks::PerlCritic;

my $GIT_ROOT;

sub set_git_root {
    my ( $class, $root ) = @_;
    $GIT_ROOT = $root;
    return;
}

sub will_check {
    my ( $self, $filepath ) = @_;
    return Git::Hooks::Compile::Perl->will_check($filepath);
}

sub check {
    my ( $self, @paths ) = @_;
    my $errors     = 0;
    my @local_args = ('--');
    if ( -e ( $GIT_ROOT . '/.perlcriticrc' ) ) {
        unshift @local_args, '-p', $GIT_ROOT . '/.perlcriticrc';
    }
    my $out = qx{perlcritic --quiet @local_args @paths};
    if ($?) {
        print($out);
        $errors++;
    }
    return !$errors;
}

package Git::Hooks::Pod::Checker;

use Pod::Checker   ();
use File::Basename qw(fileparse);
use IO::Scalar     ();

sub will_check {
    my ( $self, $filepath ) = @_;
    return 0 if !-e $filepath || -d $filepath;
    my $head = Git::Hooks::Compile::ShellCommon::read_first_line($filepath);
    my @file_infos = fileparse( $filepath, qr/[.][^.]*/x );
    return $file_infos[2] =~ /^[.]pod$/x || $head =~ /^=pod$/x ? 1 : 0;
}

sub check {
    my ( $self, @paths ) = @_;
    my $errors = 0;
    for my $file (@paths) {
        my $out;
        my $fh         = IO::Scalar->new( \$out );
        my $num_errors = podchecker( $file, $fh );
        if ($num_errors) {
            print( $file, "\n   contains POD errors" );
            $errors++;
        }
    }
    return !$errors;
}

package main;

my $nb_errors = 0;
my $git_root;

sub _setup_perl5lib {
    my ($root) = @_;
    if ( -e "$root/.git-perl5lib" ) {
        my $tmp = `cat $root/.git-perl5lib`;
        chomp $tmp;
        $ENV{'PERL5LIB'} =
          $tmp =~ s/\$PERL5LIB// ? ( $ENV{'PERL5LIB'} // '' ) . $tmp : $tmp;
        return;
    }
    $ENV{'PERL5LIB'} ||= "$root/lib";
    return;
}

sub _warn_if_hook_template_stale {
    return if !qx{ls ~/.git-templates/hooks/pre-commit};
    my $void  = qx{which md5 2>&1 > /dev/null};
    my $prog  = $? ? 'md5sum' : 'md5 -r';
    my ($me)  = qx{$prog $0}                                =~ /^([^ ]+)/x;
    my ($you) = qx{$prog ~/.git-templates/hooks/pre-commit} =~ /^([^ ]+)/x;
    return if $you eq $me;
    print(
        "###############################################################\n",
        "##\n",
        "##   WARNING: Your pre-commit hook appears to be out of date\n",
        "##\n",
        "###############################################################\n",
    );
    $nb_errors++;
    return $void;
}

sub _collect_extra_files {
    my ($root) = @_;
    my @paths;
    return @paths if !@ARGV;
    my $root_q = quotemeta $root;
    require File::Find;
    File::Find::find(
        {
            follow_fast => 1,
            wanted      => sub {
                my $f        = $_;
                my $fullname = $File::Find::fullname;
                my $name     = $File::Find::name;
                return
                  if ( $fullname // '' ) =~ /^$root_q\/[.]git(?:\/.*)?$/x;
                if ( !-e $f ) {
                    print("Could not find command line file: $f\n");
                    $nb_errors++;
                    return;
                }
                push @paths, $name if !-d $f;
            },
        },
        @ARGV,
    );
    return @paths;
}

sub _is_cursor_team_mdc {
    my ($filepath) = @_;
    return $filepath =~ m{\A[.]cursor/rules/team/.*[.]mdc\z}x;
}

sub _is_ignored_config {
    my ($filepath) = @_;
    return $filepath =~ m{\A[.]perlcriticrc\z}x;
}

sub _classify_filepath {
    my ( $filepath, $files ) = @_;
    if ( _is_cursor_team_mdc($filepath) || _is_ignored_config($filepath) ) {
        push @{ $files->{'Git::Hooks::IgnoreFile'} }, $filepath;
        return 1;
    }
    my $use_cnt = 0;
    for my $package (
        'Git::Hooks::Compile::YAML', 'Git::Hooks::Compile::Perl',
        'Git::Hooks::PerlCritic',    'Git::Hooks::Pod::Checker',
        'Git::Hooks::Compile::Bash', 'Git::Hooks::Compile::Sh',
        'Git::Hooks::IgnoreFile',    'Git::Hooks::DeletedFile',
      )
    {
        my $ret = eval { $package->will_check($filepath) };
        if ($@) {
            warn $@;
            $nb_errors++;
            next;
        }
        next if !$ret;
        my @pkgs = ref $ret eq 'ARRAY' ? @{$ret} : ($package);
        for my $pkg (@pkgs) {
            push @{ $files->{$pkg} }, $filepath;
        }
        $use_cnt++;
    }
    if ( !$use_cnt ) {
        print("pre-commit: unknown file type: $filepath\n");
        $nb_errors++;
    }
    return $use_cnt;
}

sub _run_package_checks {
    my ($files) = @_;
    for my $package ( sort keys %{$files} ) {
        my $paths = $files->{$package};
        my $num   = scalar @{$paths};
        next if !$num;
        print("Checking $package ($num files)\n");
        if ( !$package->can('check') ) {
            print("$package: check sub not found\n");
            $nb_errors++;
            next;
        }
        if ( !eval { $package->check( @{$paths} ) } ) {
            my $e = $@;
            print("$package: $e\n") if $e;
            $nb_errors++;
        }
    }
    return;
}

my $files = { 'Git::Hooks::PerlCritic' => [], };

$git_root = `git rev-parse --show-toplevel`;
chomp $git_root;
exit 1 if !$git_root;

Git::Hooks::PerlCritic->set_git_root($git_root);

_setup_perl5lib($git_root);
_warn_if_hook_template_stale();

use List::MoreUtils qw(uniq);
my @extra_files = _collect_extra_files($git_root);
my @allfiles    = uniq sort `git diff --cached --name-only`, @extra_files;
chomp @allfiles;
for my $filepath (@allfiles) {
    _classify_filepath( $filepath, $files );
}
_run_package_checks($files);

if ($nb_errors) {
    print(
        "pre-commit: Aborting commit due to pre-commit hook failure.  ",
        "You can still commit with the --no-verify argument.\n",
    );
    exit 1;
}
exit 0;
